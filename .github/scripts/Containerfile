# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:2fa828c68761b1b8c23d7662dc134421b9d3b59fe1425fdbc80804e390cdb24d AS build
ARG VERSION=0.0.0-dev
# Require the Ubuntu eMudhra trust-store security update.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20260816ubuntu0.24.04.1' \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

# Copy project file and restore dependencies
COPY PaperlessMCP.csproj .
RUN dotnet restore

# Copy source code and build
COPY . .

# Apply the custom runtime policy at image build time.
# Fail closed if the upstream source changes, so the image cannot silently drift.
RUN test "$(grep -Fxc '    private const int MaxInlineBase64Bytes = 12 * 1024;' Tools/DocumentTools.cs)" -eq 1 \
    && sed -i \
        -e 's|    private const int MaxInlineBase64Bytes = 12 \\* 1024;|    private const int DefaultMaxInlineBase64Bytes = 12 * 1024;\\n    private static int MaxInlineBase64Bytes => GetMaxInlineBase64Bytes();\\n\\n    private static int GetMaxInlineBase64Bytes()\\n    {\\n        var configured = Environment.GetEnvironmentVariable("PAPERLESS_MCP_MAX_INLINE_MB");\\n        return int.TryParse(configured, out var value) ? (value > 0 && value <= int.MaxValue / (1024 * 1024) ? value * 1024 * 1024 : DefaultMaxInlineBase64Bytes) : DefaultMaxInlineBase64Bytes;\\n    }|' \
        -e 's|inline the file bytes as base64, but only for tiny files: use paperless_documents_export_to_outbox for anything real.|inline files up to PAPERLESS_MCP_MAX_INLINE_MB MiB as base64 (default 12 KiB); use paperless_documents_export_to_outbox for larger files or when avoiding model-context transfer.|' \
        -e 's|Also return the file content as base64 (only allowed for tiny files, ~12 KB). Use paperless_documents_export_to_outbox otherwise.|Also return the file content as base64 (configurable with PAPERLESS_MCP_MAX_INLINE_MB (MiB; default 12 KiB)). Use paperless_documents_export_to_outbox for larger files or when avoiding model-context transfer.|' \
        Tools/DocumentTools.cs \
    && grep -Fq 'Environment.GetEnvironmentVariable("PAPERLESS_MCP_MAX_INLINE_MB")' Tools/DocumentTools.cs \
    && grep -Fq 'DefaultMaxInlineBase64Bytes = 12 * 1024' Tools/DocumentTools.cs
RUN dotnet publish -c Release -o /app/publish /p:Version=${VERSION}

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:6a94333d37514e385650a3c81a55e5350b67253dbe136e9cf17e499c35606a8c AS runtime
ARG VERSION=0.0.0-dev
# Require the Ubuntu eMudhra trust-store security update.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge '20260816ubuntu0.24.04.1' \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# OCI Labels
LABEL org.opencontainers.image.title="PaperlessMCP"
LABEL org.opencontainers.image.description="Model Context Protocol server for Paperless-ngx"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.source="https://github.com/barryw/PaperlessMCP"
LABEL org.opencontainers.image.licenses="MIT"

# Copy published application
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV MCP_PORT=5000

# Expose port for HTTP transport
EXPOSE 5000

# Run the application (HTTP mode by default)
ENTRYPOINT ["dotnet", "PaperlessMCP.dll"]
